+// Exact q4_0 GQA decode specialization for Qwen's 24 Q / 4 KV heads.
+// Keep each query's original online-softmax order; reuse a V dequantization
+// and the hot K row across its six queries. Other shapes retain the old path.
+static void ggml_compute_forward_flash_attn_ext_q4_qwen(
+        const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    constexpr int D = 256, GROUP = 6;
+    float scale;
+    memcpy(&scale, dst->op_params, sizeof(float));
+    const auto * traits = ggml_get_type_traits_cpu(k->type);
+    const auto q_to_vec_dot = ggml_get_type_traits_cpu(traits->vec_dot_type)->from_float;
+    const auto kq_vec_dot = traits->vec_dot;
+    const auto v_to_float = ggml_get_type_traits(v->type)->to_float;
+    alignas(64) ggml_fp16_t Q_q[GROUP][D];
+    alignas(64) float accum[GROUP][D];
+    alignas(64) float V32[D];
+    float maximum[GROUP], sum[GROUP];
+    const auto * mp = mask ? static_cast<const ggml_fp16_t *>(mask->data) : nullptr;
+    for (int64_t kv_head = params->ith; kv_head < k->ne[2]; kv_head += params->nth) {
+        memset(accum, 0, sizeof(accum));
+        for (int h = 0; h < GROUP; ++h) {
+            const int64_t head = kv_head * GROUP + h;
+            q_to_vec_dot(reinterpret_cast<const float *>(static_cast<const char *>(q->data) + head * q->nb[2]), Q_q[h], D);
+            maximum[h] = -INFINITY;
+            sum[h] = 0;
+        }
+        for (int64_t ic = 0; ic < k->ne[1]; ++ic) {
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.f;
+            if (mv == -INFINITY) continue;
+            const auto * key = static_cast<const char *>(k->data) + ic * k->nb[1] + kv_head * k->nb[2];
+            const auto * value = static_cast<const char *>(v->data) + ic * v->nb[1] + kv_head * v->nb[2];
+            v_to_float(value, V32, D);
+            for (int h = 0; h < GROUP; ++h) {
+                float s;
+                kq_vec_dot(D, &s, 0, key, 0, Q_q[h], 0, 1);
+                s = s * scale;
+                s += mv;
+                const float previous = maximum[h];
+                float ms = 1.f, vs = 1.f;
+                if (s > maximum[h]) {
+                    maximum[h] = s;
+                    ms = expf(previous - maximum[h]);
+                    ggml_vec_scale_f32(D, accum[h], ms);
+                } else {
+                    vs = expf(s - maximum[h]);
+                }
+                ggml_vec_mad_f32(D, accum[h], V32, vs);
+                sum[h] = sum[h] * ms + vs;
+            }
+        }
+        for (int h = 0; h < GROUP; ++h) {
+            const int64_t head = kv_head * GROUP + h;
+            if (sinks) {
+                const float s = static_cast<const float *>(sinks->data)[head];
+                float ms = 1.f, vs = 1.f;
+                if (s > maximum[h]) {
+                    ms = expf(maximum[h] - s);
+                    maximum[h] = s;
+                    ggml_vec_scale_f32(D, accum[h], ms);
+                } else {
+                    vs = expf(s - maximum[h]);
+                }
+                sum[h] = sum[h] * ms + vs;
+            }
+            ggml_vec_scale_f32(D, accum[h], sum[h] == 0.f ? 0.f : 1.f / sum[h]);
+            memcpy(static_cast<char *>(dst->data) + head * dst->nb[1], accum[h], D * sizeof(float));
+        }
+    }
+}
