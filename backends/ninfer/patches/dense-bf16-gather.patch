+
+// Adapted from mkyt/qwen3-27b-5090 embed_gather_kernel (MIT; THIRD_PARTY_NOTICES.md).
+// One CTA per row stages independent 16-byte reads before using them, so mapped host
+// rows can issue their PCIe reads together. Copy raw bits: converting via FP32 would
+// unnecessarily change the dense embedding contract for NaN payloads.
+// Launcher domain: aligned source/output, D % 8 == 0, D <= 4*8*1024.
+__global__ void embed_gather_dense_staged_kernel(const std::int32_t* ids,
+                                                 const __nv_bfloat16* table,
+                                                 __nv_bfloat16* out, std::int32_t d) {
+    const auto row = static_cast<std::int64_t>(ids[blockIdx.x]);
+    const auto* source = reinterpret_cast<const uint4*>(table + row * d);
+    auto* destination = reinterpret_cast<uint4*>(out + static_cast<std::int64_t>(blockIdx.x) * d);
+    const int vectors = d / 8;
+    uint4 staged[4];
+#pragma unroll
+    for (int item = 0; item < 4; ++item) {
+        const int index = threadIdx.x + item * blockDim.x;
+        if (index < vectors) staged[item] = source[index];
+    }
+#pragma unroll
+    for (int item = 0; item < 4; ++item) {
+        const int index = threadIdx.x + item * blockDim.x;
+        if (index < vectors) destination[index] = staged[item];
     }
 }
 
