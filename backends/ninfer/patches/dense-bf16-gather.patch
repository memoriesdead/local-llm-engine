diff --git a/tests/ops/embedding_dense_sweep.cu b/tests/ops/embedding_dense_sweep.cu
new file mode 100644
--- /dev/null
+++ b/tests/ops/embedding_dense_sweep.cu
@@ -0,0 +1,183 @@
+// Local Speed Engine gather microbenchmark; Apache-2.0, with the mkyt MIT notice in THIRD_PARTY_NOTICES.md.
+// Task-local candidate comparison. Remove this forcing surface after selecting a route.
+// Standalone: nvcc -std=c++20 -arch=sm_120a -I src -I include
+//   tests/ops/embedding_dense_sweep.cu -o build/embedding_dense_sweep
+// Timings are hot repeated-input eager/graph CUDA-event averages, not model throughput.
+#include "ops/kernel/embed_gather.cuh"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+void check(cudaError_t status) {
+    if (status != cudaSuccess) throw std::runtime_error(cudaGetErrorString(status));
+}
+
+struct Allocation {
+    void* pointer = nullptr;
+    bool host;
+    Allocation(std::size_t bytes, bool mapped) : host(mapped) {
+        if (host) check(cudaHostAlloc(&pointer, bytes, cudaHostAllocMapped));
+        else check(cudaMalloc(&pointer, bytes));
+    }
+    ~Allocation() { if (host) cudaFreeHost(pointer); else cudaFree(pointer); }
+    Allocation(const Allocation&) = delete;
+    Allocation& operator=(const Allocation&) = delete;
+};
+
+void launch(bool staged, const std::int32_t* ids, const __nv_bfloat16* table,
+            __nv_bfloat16* output, int tokens, cudaStream_t stream) {
+    constexpr int d = 5120;
+    if (staged)
+        ninfer::ops::embed_gather_dense_staged_kernel<<<tokens, 160, 0, stream>>>(
+            ids, table, output, d);
+    else
+        ninfer::ops::embed_gather_dense_kernel<<<tokens * (d / 128), 128, 0, stream>>>(
+            ids, table, output, d, tokens);
+    check(cudaGetLastError());
+}
+
+double time_route(bool staged, const std::int32_t* ids, const __nv_bfloat16* table,
+                  __nv_bfloat16* output, int tokens, int iterations, bool graph_mode,
+                  cudaStream_t stream) {
+    constexpr int graph_nodes = 128;
+    const int replays = std::max(2, 1 + (iterations - 1) / graph_nodes);
+    struct Graph {
+        cudaGraph_t definition = nullptr;
+        cudaGraphExec_t executable = nullptr;
+        ~Graph() {
+            if (executable) cudaGraphExecDestroy(executable);
+            if (definition) cudaGraphDestroy(definition);
+        }
+    } graph;
+    if (graph_mode) {
+        check(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+        for (int node = 0; node < graph_nodes; ++node)
+            launch(staged, ids, table, output, tokens, stream);
+        check(cudaStreamEndCapture(stream, &graph.definition));
+        check(cudaGraphInstantiate(&graph.executable, graph.definition, 0));
+        for (int warmup = 0; warmup < 3; ++warmup)
+            check(cudaGraphLaunch(graph.executable, stream));
+    } else {
+        for (int i = 0; i < 20; ++i) launch(staged, ids, table, output, tokens, stream);
+    }
+    check(cudaStreamSynchronize(stream));
+    cudaEvent_t begin, end;
+    check(cudaEventCreate(&begin));
+    check(cudaEventCreate(&end));
+    check(cudaEventRecord(begin, stream));
+    if (graph_mode) {
+        for (int replay = 0; replay < replays; ++replay)
+            check(cudaGraphLaunch(graph.executable, stream));
+    } else {
+        for (int i = 0; i < iterations; ++i) launch(staged, ids, table, output, tokens, stream);
+    }
+    check(cudaEventRecord(end, stream));
+    check(cudaEventSynchronize(end));
+    float elapsed = 0;
+    check(cudaEventElapsedTime(&elapsed, begin, end));
+    check(cudaEventDestroy(begin));
+    check(cudaEventDestroy(end));
+    const double kernels = graph_mode ? static_cast<double>(graph_nodes) * replays : iterations;
+    return elapsed * 1000.0 / kernels;
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        std::string route = "both";
+        int iterations = 1000;
+        bool graph_mode = false;
+        for (int i = 1; i < argc; ++i) {
+            if (!std::strcmp(argv[i], "--route") && i + 1 < argc) route = argv[++i];
+            else if (!std::strcmp(argv[i], "--iterations") && i + 1 < argc)
+                iterations = std::stoi(argv[++i]);
+            else if (!std::strcmp(argv[i], "--graph")) graph_mode = true;
+            else throw std::invalid_argument("usage: embedding_dense_sweep [--route baseline|candidate|both] [--iterations N] [--graph]");
+        }
+        if ((route != "both" && route != "baseline" && route != "candidate") || iterations <= 0)
+            throw std::invalid_argument("invalid route or iteration count");
+        int count = 0;
+        check(cudaGetDeviceCount(&count));
+        if (!count) { std::puts("SKIP: no CUDA device"); return 77; }
+        cudaDeviceProp properties{};
+        check(cudaGetDeviceProperties(&properties, 0));
+        if (graph_mode) {
+            const int replays = std::max(2, 1 + (iterations - 1) / 128);
+            std::printf("GPU=%s; graph CUDA events; hot repeated inputs; 128 kernel nodes/graph; "
+                        "3 graph warmups; %d timed graph replays; %.0f timed kernels; 3 alternating trials\n",
+                        properties.name, replays, 128.0 * replays);
+        } else {
+            std::printf("GPU=%s; eager CUDA events; hot repeated inputs; 20 warmups; %d iterations; 3 alternating trials\n",
+                        properties.name, iterations);
+        }
+        constexpr int rows = 4096, d = 5120;
+        std::vector<std::uint16_t> bits(static_cast<std::size_t>(rows) * d);
+        std::uint32_t state = 0xb731e345u;
+        for (auto& value : bits) { state = state * 1664525u + 1013904223u; value = state >> 8; }
+        Allocation device_table(bits.size() * 2, false), host_table(bits.size() * 2, true);
+        check(cudaMemcpy(device_table.pointer, bits.data(), bits.size() * 2, cudaMemcpyHostToDevice));
+        std::memcpy(host_table.pointer, bits.data(), bits.size() * 2);
+        void* host_alias = nullptr;
+        check(cudaHostGetDevicePointer(&host_alias, host_table.pointer, 0));
+        cudaStream_t stream;
+        check(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        for (bool mapped : {false, true}) {
+            const auto* table = static_cast<const __nv_bfloat16*>(mapped ? host_alias : device_table.pointer);
+            for (int tokens : {1, 8, 32, 128, 512}) {
+                std::vector<std::int32_t> ids(tokens);
+                for (auto& id : ids) { state = state * 1664525u + 1013904223u; id = state % rows; }
+                std::vector<std::uint16_t> expected(static_cast<std::size_t>(tokens) * d);
+                for (int t = 0; t < tokens; ++t)
+                    std::copy_n(bits.data() + static_cast<std::size_t>(ids[t]) * d, d,
+                                expected.data() + static_cast<std::size_t>(t) * d);
+                Allocation input(ids.size() * 4, false), output(expected.size() * 2, false);
+                check(cudaMemcpy(input.pointer, ids.data(), ids.size() * 4, cudaMemcpyHostToDevice));
+                auto* id_device = static_cast<const std::int32_t*>(input.pointer);
+                auto* out_device = static_cast<__nv_bfloat16*>(output.pointer);
+                std::vector<double> measurements[2];
+                for (bool staged : {false, true}) {
+                    if (route != "both" && (staged != (route == "candidate"))) continue;
+                    launch(staged, id_device, table, out_device, tokens, stream);
+                    check(cudaStreamSynchronize(stream));
+                    std::vector<std::uint16_t> actual(expected.size());
+                    check(cudaMemcpy(actual.data(), output.pointer, actual.size() * 2, cudaMemcpyDeviceToHost));
+                    if (actual != expected) throw std::runtime_error("CPU byte-gather oracle mismatch");
+                }
+                for (int trial = 0; trial < 3; ++trial) {
+                    for (int ordinal = 0; ordinal < 2; ++ordinal) {
+                        const bool staged = (ordinal ^ (trial & 1)) != 0;
+                        if (route != "both" && (staged != (route == "candidate"))) continue;
+                        const double us = time_route(staged, id_device, table, out_device,
+                                                     tokens, iterations, graph_mode, stream);
+                        // Also qualify the output left by graph replay, not only the eager
+                        // launch checked above; the independent CPU byte oracle is unchanged.
+                        std::vector<std::uint16_t> actual(expected.size());
+                        check(cudaMemcpy(actual.data(), output.pointer, actual.size() * 2,
+                                         cudaMemcpyDeviceToHost));
+                        if (actual != expected) throw std::runtime_error("timed CPU byte-gather oracle mismatch");
+                        measurements[staged].push_back(us);
+                        std::printf("mode=%s storage=%s D=%d T=%d route=%s trial=%d us_per_kernel=%.4f\n",
+                            graph_mode ? "graph-hot" : "eager-hot", mapped ? "mapped-host" : "device", d, tokens,
+                            staged ? "candidate" : "baseline", trial + 1, us);
+                    }
+                }
+                for (auto& values : measurements) std::sort(values.begin(), values.end());
+                if (route == "both") std::printf("median mode=%s storage=%s T=%d baseline_us=%.4f candidate_us=%.4f ratio=%.4f\n",
+                    graph_mode ? "graph-hot" : "eager-hot", mapped ? "mapped-host" : "device", tokens, measurements[0][1],
+                    measurements[1][1], measurements[0][1] / measurements[1][1]);
+            }
+        }
+        check(cudaStreamDestroy(stream));
+        std::puts("OK dense embedding CPU-oracle parity; timing scope is the gather only");
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "dense embedding sweep: %s\n", error.what());
+        return 1;
+    }
+}
