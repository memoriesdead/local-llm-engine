+    failures += test_dense_storage(5120, 8, 2, 0);
+    failures += test_dense_storage(5120, 8, 0, 2);
+    for (int d : {1, 7, 8, 9, 5119, 5121, 32768, 32776})
+        failures += test_dense_storage(d, 3);
+    return failures;
+}
+
