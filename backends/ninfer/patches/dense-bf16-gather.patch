+// Dense embedding is an exact byte gather, including NaN payloads and signed zero.
+// Use a small vocabulary but the real 5120-channel text shape, with independently
+// indexed CPU rows rather than a second GPU gather as the oracle.
+int test_dense_storage(std::int32_t d, std::int32_t t, std::size_t table_offset = 0,
+                        std::size_t output_offset = 0, bool replay = false) {
+    constexpr std::int32_t rows = 257;
+    std::vector<std::uint16_t> table(static_cast<std::size_t>(rows) * d);
+    std::uint32_t rng = 0x43b714d5u;
+    const auto next = [&] { rng = rng * 1664525u + 1013904223u; return rng; };
+    for (auto& bits : table) bits = static_cast<std::uint16_t>(next() >> 8);
+    const std::size_t bytes = table.size() * sizeof(std::uint16_t);
+    GuardedDeviceBuffer device_table(bytes + table_offset);
+    device_table.fill(0xa7);
+    device_table.copy_from_host(table.data(), bytes, table_offset);
+    HostPages host(bytes + table_offset);
+    std::memset(host.data(), 0xa7, host.size());
+    std::memcpy(host.data() + table_offset, table.data(), bytes);
+    host.pin(true);
+    void* mapped = nullptr;
+    cuda_check(cudaHostGetDevicePointer(&mapped, host.data(), 0), "map dense embedding table");
+    int failures = 0;
+    for (bool on_host : {false, true}) {
+        std::vector<std::int32_t> ids(t);
+        for (auto& id : ids) id = static_cast<std::int32_t>(next() % rows);
+        ids[0] = 0;
+        if (t > 1) ids[1] = rows - 1;
+        if (t > 2) ids[2] = ids[1];
+        GuardedDeviceBuffer device_ids(ids.size() * sizeof(std::int32_t));
+        GuardedDeviceBuffer output(static_cast<std::size_t>(d) * t * 2 + output_offset);
+        Weight weight{};
+        weight.qtype = QType::BF16;
+        weight.layout = QuantLayout::Contiguous;
+        weight.payload = static_cast<std::uint8_t*>(on_host ? mapped : device_table.data()) + table_offset;
+        weight.qdata = weight.payload;
+        weight.payload_bytes = bytes;
+        weight.ndim = 2;
+        weight.shape[0] = weight.padded_shape[0] = weight.n = rows;
+        weight.shape[1] = weight.padded_shape[1] = weight.k = d;
+        Tensor input(device_ids.data(), DType::I32, {t});
+        Tensor result(static_cast<std::uint8_t*>(output.data()) + output_offset,
+                      DType::BF16, {d, t});
+        DeviceContext device;
+        DecodeGraphDefinition definition;
+        DecodeGraphExecutable graph;
+        const auto launch = [&] { ops::embedding(input, weight, result, device.stream); };
+        const std::string label = "embedding dense " + std::string(on_host ? "host" : "device") +
+            " D=" + std::to_string(d) + " T=" + std::to_string(t) +
+            " table-offset=" + std::to_string(table_offset) +
+            " output-offset=" + std::to_string(output_offset) + (replay ? " Graph" : "");
+        for (int phase = 0; phase < (replay ? 2 : 1); ++phase) {
+            if (phase) for (auto& id : ids) id = static_cast<std::int32_t>(next() % rows);
+            device_ids.copy_from_host(ids.data(), ids.size() * 4);
+            output.fill(0x7d);
+            if (replay && phase == 0) {
+                definition.capture(device.stream, launch);
+                graph.instantiate(definition);
+            }
+            if (replay) graph.launch(device.stream); else launch();
+            cuda_synchronize(device.stream);
+            std::vector<std::uint16_t> expected(static_cast<std::size_t>(d) * t);
+            for (std::int32_t column = 0; column < t; ++column)
+                std::copy_n(table.data() + static_cast<std::size_t>(ids[column]) * d, d,
+                            expected.data() + static_cast<std::size_t>(column) * d);
+            std::vector<std::uint16_t> actual(expected.size());
+            output.copy_to_host(actual.data(), actual.size() * 2, output_offset);
+            failures += verify_exact(label.c_str(), actual, expected);
+            failures += output.verify_guards(label) + verify_input(label.c_str(), device_ids, ids);
+            if (output_offset) {
+                std::vector<std::uint8_t> prefix(output_offset);
+                output.copy_to_host(prefix.data(), prefix.size());
+                failures += verify_exact(label.c_str(), prefix, std::vector<std::uint8_t>(output_offset, 0x7d));
+            }
+        }
+    }
+    std::vector<std::uint16_t> unchanged(table.size());
+    device_table.copy_to_host(unchanged.data(), bytes, table_offset);
+    failures += verify_exact("dense device table unchanged", unchanged, table);
+    std::memcpy(unchanged.data(), host.data() + table_offset, bytes);
+    failures += verify_exact("dense host table unchanged", unchanged, table);
+    failures += device_table.verify_guards("dense device table");
+    return failures;
+}
+
+int test_dense_storage_domains() {
+    int failures = 0;
+    for (int t : {1, 8, 31, 32, 33, 128, 129}) failures += test_dense_storage(5120, t);
